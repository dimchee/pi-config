{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.0/schema.json",
  "applyBuiltinDefaults": true,
  "version": "0.16.2",
  "onboarding": {
    "completed": true,
    "completedAt": "2026-06-28T17:24:29.644Z",
    "version": "0.13.0-20260619"
  },
  "features": {
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      {
        "kind": "file",
        "path": "/dev/null"
      }
    ]
  },
  "permissionGate": {
    "allowedPatterns": [
      {
        "pattern": "rm -rf .*(?<!(?<!\\.)\\/)\\b(zig-out|\\.zig-cache|target|build|dist|node_modules|\\.cache|out|tmp|coverage|__pycache__)\\b",
        "regex": true
      }
    ]
  }
}
